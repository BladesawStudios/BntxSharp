<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The TexSharp project to build against. Beside this library (as in a checkout of all of them) the shared copy is used,
         so a program that uses several of these libraries gets one TexSharp; on its own the embedded copy is. Set TexSharpProject to choose. -->
    <TexSharpProject Condition="'$(TexSharpProject)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\TexSharp\src\TexSharp\TexSharp.csproj')">$(MSBuildThisFileDirectory)..\..\..\TexSharp\src\TexSharp\TexSharp.csproj</TexSharpProject>
    <TexSharpProject Condition="'$(TexSharpProject)' == ''">$(MSBuildThisFileDirectory)..\..\lib\TexSharp\src\TexSharp\TexSharp.csproj</TexSharpProject>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BntxSharp</PackageId>
    <Version>1.1.0</Version>
    <Authors>Aiden A</Authors>
    <Description>A reader and writer for Nintendo Switch BNTX texture containers, with Tegra X1 block-linear swizzling, and DDS export and decoding through TexSharp.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(TexSharpProject)" />
  </ItemGroup>

</Project>
